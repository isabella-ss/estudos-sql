-- Criando o banco
CREATE DATABASE db_lib;

USE db_lib;


-- Criando tabela de editoras
CREATE TABLE tb_editora (
    cd_editora INT NOT NULL PRIMARY KEY,
    editora VARCHAR(50) NOT NULL
);


-- Criando tabela de gêneros
CREATE TABLE tb_genero (
    cd_genero INT NOT NULL PRIMARY KEY,
    genero VARCHAR(50) NOT NULL
);


-- Criando tabela de livros
CREATE TABLE tb_livro (
    isbn INT NOT NULL PRIMARY KEY,
    titulo VARCHAR(50) NOT NULL,
    cd_editora INT NOT NULL,
    cd_genero INT NOT NULL,
    preco DECIMAL(10, 2),
    dt_livro DATE,

    CONSTRAINT fk_livro_editora
        FOREIGN KEY (cd_editora)
        REFERENCES tb_editora(cd_editora),

    CONSTRAINT fk_livro_genero
        FOREIGN KEY (cd_genero)
        REFERENCES tb_genero(cd_genero)
);

